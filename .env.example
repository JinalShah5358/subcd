# ---------------------------------------------------------------------------
# IFP Platform — environment variable NAMES ONLY.
# Copy to .env and fill in locally. NEVER commit a filled .env.
# In deployed environments these are injected from the secrets manager;
# no .env file should exist on a server.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

# The browser extension calls from chrome-extension://<id>, which cannot be in
# WEB_ORIGIN because the id is per-installation. Leave this unset in development
# and any extension origin is accepted; in production it MUST name the id, or
# the extension is refused.
# EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef

# --- Database ---
# App role: RLS-enforced, no BYPASSRLS, no DDL.
DATABASE_URL=postgresql://ifp_app:ifp_app_dev_pw@localhost:5433/ifp?schema=public
# Migration role: DDL only, used by prisma migrate.
DATABASE_DIRECT_URL=postgresql://ifp_owner:ifp_owner_dev_pw@localhost:5433/ifp?schema=public

# --- Auth ---
# 32+ byte random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_IDLE_TTL_HOURS=72

# --- Crypto (application-layer encryption) ---
# Local development KMS stub. In production this is replaced by a real KMS CMK id.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KMS_MODE=local
KMS_LOCAL_MASTER_KEY=
# Separate secret, NOT stored in the database. Used for HMAC blind indexes.
BLIND_INDEX_PEPPER=

# --- Mail (invites / password resets only) ---
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IFP Platform <no-reply@localhost>"

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true

# --- Feature flags ---
# Full Aadhaar storage stays OFF. Enabling also requires dropping a DB CHECK
# constraint via a reviewed migration — see ADR-013.
FEATURE_AADHAAR_FULL_STORAGE=false
FEATURE_DOCUMENT_UPLOADS=false
