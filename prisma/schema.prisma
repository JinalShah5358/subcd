// ---------------------------------------------------------------------------
// IFP Subsidy Platform — MVP schema (admin side: web + API)
//
// Scope note: the form/mapping catalog (FormDefinition, FormVersion, FormField,
// FieldMapping, DropdownMapping), autofill telemetry and ExtensionDevice are
// intentionally NOT in this migration. They arrive with the browser extension
// phase. See PROJECT_PLAN.html -> Database for their full specification.
//
// Conventions
//   * Primary key is `id`, holding a UUID v7 GUID generated by the application.
//   * snake_case column and table names via @map / @@map.
//   * Money is Decimal(16,2). Never Float. See ADR-014.
//   * Sensitive identifiers are stored as `*Enc` (AES-256-GCM ciphertext) plus
//     `*Last4` for display and `*BlindIndex` (HMAC-SHA256) for equality search.
//   * Every tenant-owned table carries firmId and is covered by RLS.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ============================ ENUMS ============================

enum FirmStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum LicensePlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum EntityType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PVT_LTD
  PUBLIC_LTD
  HUF
  TRUST
  SOCIETY
  COOP
  OTHER
}

enum PromoterRole {
  PROPRIETOR
  PARTNER
  DIRECTOR
  TRUSTEE
  MEMBER
  OTHER
}

enum ApplicationType {
  CAPITAL_SUBSIDY
  INTEREST_SUBSIDY
  PROVISIONAL_ELIGIBILITY
  FINAL_ELIGIBILITY
}

enum CaseStatus {
  DRAFT
  IN_REVIEW
  READY_TO_FILE
  FILED
  ACKNOWLEDGED
  QUERY_RAISED
  APPROVED
  REJECTED
  WITHDRAWN
  ARCHIVED
}

enum AreaType {
  URBAN
  RURAL
  MUNICIPAL
  GIDC
  OTHER
}

enum RateType {
  FIXED
  FLOATING
}

enum BankType {
  PSU
  PRIVATE
  COOP
  RRB
  NBFC
  SFB
  OTHER
}

enum DocumentCategory {
  ENTITY
  PROMOTER
  PROJECT
  FINANCE
  EMPLOYMENT
  SALES
  OTHER
}

enum DocumentSlotStatus {
  REQUIRED
  PRESENT
  NOT_AVAILABLE
  NOT_APPLICABLE
  REJECTED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  QUERY
}

enum SchemeVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum RuleSeverity {
  BLOCKING
  WARNING
  INFO
}

enum RuleCategory {
  FORMAT
  REQUIRED
  DATE_WINDOW
  CONSISTENCY
  RATIO
  DUPLICATE
  DOCUMENT
  CROSS_FIELD
}

enum RuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum RuleAppliesTo {
  CASE
  CLIENT
  DOCUMENT
}

enum ValidationTrigger {
  MANUAL
  ON_SAVE
  PRE_AUTOFILL
  SCHEDULED
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  WAIVED
  RESOLVED
}

enum ConsentStatus {
  RECORDED
  WITHDRAWN
  EXPIRED
}

enum ConsentMethod {
  CA_ATTESTATION
  SIGNED_DOCUMENT
  EMAIL_CONFIRMATION
}

enum ClientAppType {
  WEB
  EXTENSION
  SYSTEM
  CLI
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum AuditAction {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESHED
  TOKEN_REUSE_DETECTED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  USER_INVITED
  USER_ACTIVATED
  USER_UPDATED
  USER_DISABLED
  ROLE_CHANGED
  EXTENSION_PAIRING_STARTED
  EXTENSION_DEVICE_PAIRED
  EXTENSION_DEVICE_REVOKED
  FORM_CAPTURED
  FORM_VERSION_STATUS_CHANGED
  FIELD_MAPPED
  AUTOFILL_COMPLETED
  FIRM_CREATED
  FIRM_UPDATED
  FIRM_STATUS_CHANGED
  FIRM_LICENSE_CHANGED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  PROMOTER_CREATED
  PROMOTER_UPDATED
  PROMOTER_DELETED
  CASE_CREATED
  CASE_UPDATED
  CASE_STATUS_CHANGED
  CASE_DELETED
  CASE_SECTION_UPDATED
  SENSITIVE_DATA_VIEWED
  SENSITIVE_FIELD_REVEALED
  DOCUMENT_SLOT_UPDATED
  DATA_EXPORTED
  VALIDATION_RUN
  VALIDATION_WAIVED
  CONSENT_RECORDED
  CONSENT_WITHDRAWN
  RULE_VERSION_PUBLISHED
  RETENTION_PURGE_EXECUTED
  ACCESS_DENIED
}

// ======================= TENANCY & IDENTITY =======================

model Firm {
  id           String     @id @db.Uuid
  name         String     @db.VarChar(200)
  slug         String     @unique @db.VarChar(64)
  frn          String?    @unique @db.VarChar(32)
  gstin        String?    @unique @db.VarChar(15)
  contactEmail String?    @map("contact_email") @db.VarChar(254)
  contactPhone String?    @map("contact_phone") @db.VarChar(20)
  addressLine1 String?    @map("address_line1") @db.VarChar(200)
  addressLine2 String?    @map("address_line2") @db.VarChar(200)
  city         String?    @db.VarChar(100)
  state        String?    @db.VarChar(100)
  pincode      String?    @db.VarChar(6)
  status       FirmStatus @default(ACTIVE)
  dataRegion   String     @default("in-west") @map("data_region") @db.VarChar(16)

  // ------------------------------ licensing ------------------------------
  // What this firm has paid for. Set by a platform administrator; no part of
  // the firm-facing API can write these. A null quota means unlimited, and a
  // null expiry means a licence with no end date.
  plan             LicensePlan @default(TRIAL)
  /// Date-only: the licence is valid through the end of this day in IST.
  licenseExpiresAt DateTime?   @map("license_expires_at") @db.Date
  /// Days after expiry during which writes are still accepted.
  licenseGraceDays Int         @default(14) @map("license_grace_days")
  maxUsers         Int?        @map("max_users")
  maxClients       Int?        @map("max_clients")
  maxCases         Int?        @map("max_cases")
  licenseNote      String?     @map("license_note") @db.VarChar(500)
  licenseUpdatedAt DateTime?   @map("license_updated_at")
  // -----------------------------------------------------------------------
  retentionMonths  Int         @default(96) @map("retention_months")
  /// Wrapped per-firm data encryption key (envelope encryption).
  wrappedDek       Bytes?      @map("wrapped_dek")
  dekVersion       Int         @default(1) @map("dek_version")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  users            User[]
  roles            Role[]
  invitations      Invitation[]
  refreshTokens    RefreshToken[]
  resetTokens      PasswordResetToken[]
  clients          Client[]
  promoters        ClientPromoter[]
  cases            Case[]
  projects         Project[]
  loans            Loan[]
  employments      Employment[]
  investments      Investment[]
  firstSales       FirstSale[]
  caseDocuments    CaseDocument[]
  validationRuns   CaseValidationRun[]
  consentRecords   ConsentRecord[]
  auditLogs        AuditLog[]
  banks            Bank[]
  documentTypes    DocumentType[]
  formVersions     FormVersion[]
  formFields       FormField[]
  fieldMappings    FieldMapping[]
  extensionDevices ExtensionDevice[]
  autofillSessions AutofillSession[]
  autofillOutcomes AutofillFieldOutcome[]

  @@index([status])
  @@index([createdAt])
  @@index([licenseExpiresAt])
  @@map("firm")
}

model Role {
  id          String   @id @db.Uuid
  /// Null = system role shared by every firm. Non-null = firm-defined (future).
  firmId      String?  @map("firm_id") @db.Uuid
  key         String   @db.VarChar(32)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(250)
  permissions String[]
  isSystem    Boolean  @default(true) @map("is_system")
  rank        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  firm        Firm?        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  users       User[]
  invitations Invitation[]

  @@unique([firmId, key])
  @@index([firmId])
  @@map("role")
}

model User {
  id                String     @id @db.Uuid
  firmId            String     @map("firm_id") @db.Uuid
  email             String     @db.VarChar(254)
  emailNormalized   String     @unique @map("email_normalized") @db.VarChar(254)
  passwordHash      String?    @map("password_hash")
  passwordUpdatedAt DateTime?  @map("password_updated_at")
  fullName          String     @map("full_name") @db.VarChar(160)
  phone             String?    @db.VarChar(20)
  roleId            String     @map("role_id") @db.Uuid
  status            UserStatus @default(INVITED)
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEnc      Bytes?     @map("mfa_secret_enc")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until")
  lastLoginAt       DateTime?  @map("last_login_at")
  lastLoginIp       String?    @map("last_login_ip") @db.Inet
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  firm             Firm                    @relation(fields: [firmId], references: [id], onDelete: Restrict)
  role             Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens    RefreshToken[]
  resetTokens      PasswordResetToken[]
  invitationsSent  Invitation[]            @relation("InvitedBy")
  clientsCreated   Client[]                @relation("ClientCreatedBy")
  casesCreated     Case[]                  @relation("CaseCreatedBy")
  casesAssigned    Case[]                  @relation("CaseAssignedTo")
  validationRuns   CaseValidationRun[]
  findingsWaived   CaseValidationFinding[]
  consentsRecorded ConsentRecord[]
  documentsChecked CaseDocument[]
  extensionDevices ExtensionDevice[]
  autofillSessions AutofillSession[]

  @@unique([firmId, email])
  @@index([firmId, status])
  @@index([firmId, roleId])
  @@map("app_user")
}

model Invitation {
  id              String    @id @db.Uuid
  firmId          String    @map("firm_id") @db.Uuid
  email           String    @db.VarChar(254)
  fullName        String    @map("full_name") @db.VarChar(160)
  roleId          String    @map("role_id") @db.Uuid
  /// SHA-256 of the emailed token. The raw token is never stored.
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  firm      Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy User? @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([firmId, email])
  @@index([expiresAt])
  @@map("invitation")
}

model RefreshToken {
  id            String        @id @db.Uuid
  firmId        String        @map("firm_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  /// Rotation family. Re-use of a spent token revokes the whole family.
  familyId      String        @map("family_id") @db.Uuid
  tokenHash     String        @unique @map("token_hash") @db.VarChar(64)
  clientType    ClientAppType @default(WEB) @map("client_type")
  userAgentHash String?       @map("user_agent_hash") @db.VarChar(64)
  ipAtIssue     String?       @map("ip_at_issue") @db.Inet
  issuedAt      DateTime      @default(now()) @map("issued_at")
  expiresAt     DateTime      @map("expires_at")
  usedAt        DateTime?     @map("used_at")
  revokedAt     DateTime?     @map("revoked_at")
  revokedReason String?       @map("revoked_reason") @db.VarChar(120)

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientType])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  firmId    String    @map("firm_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  requestIp String?   @map("request_ip") @db.Inet
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

// ========================= REFERENCE DATA =========================

model District {
  id        String   @id @db.Uuid
  code      String   @unique @db.VarChar(12)
  name      String   @db.VarChar(120)
  stateCode String   @default("GJ") @map("state_code") @db.VarChar(4)
  dicCode   String?  @map("dic_code") @db.VarChar(12)
  dicName   String?  @map("dic_name") @db.VarChar(160)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  talukas Taluka[]

  @@index([stateCode, isActive])
  @@map("district")
}

model Taluka {
  id         String   @id @db.Uuid
  districtId String   @map("district_id") @db.Uuid
  code       String   @unique @db.VarChar(12)
  name       String   @db.VarChar(120)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([districtId, isActive])
  @@map("taluka")
}

model Bank {
  id         String    @id @db.Uuid
  /// Null = globally seeded reference row. Non-null = added by a firm, pending curation.
  firmId     String?   @map("firm_id") @db.Uuid
  name       String    @db.VarChar(160)
  branchName String    @map("branch_name") @db.VarChar(160)
  ifsc       String?   @unique @db.VarChar(11)
  bankType   BankType? @map("bank_type")
  city       String?   @db.VarChar(100)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  firm  Firm?  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  loans Loan[]

  @@index([firmId])
  @@index([name])
  @@map("bank")
}

model DocumentType {
  id          String           @id @db.Uuid
  firmId      String?          @map("firm_id") @db.Uuid
  code        String           @db.VarChar(48)
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(400)
  category    DocumentCategory @default(OTHER)
  sortOrder   Int              @default(100) @map("sort_order")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  firm         Firm?                       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  caseDocs     CaseDocument[]
  requirements SchemeDocumentRequirement[]

  @@unique([firmId, code])
  @@index([category, isActive])
  @@map("document_type")
}

// ============================ SCHEME ============================

model Scheme {
  id          String   @id @db.Uuid
  code        String   @unique @db.VarChar(48)
  name        String   @db.VarChar(200)
  authority   String?  @db.VarChar(200)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions SchemeVersion[]

  @@map("scheme")
}

model SchemeVersion {
  id              String              @id @db.Uuid
  schemeId        String              @map("scheme_id") @db.Uuid
  versionLabel    String              @map("version_label") @db.VarChar(32)
  effectiveFrom   DateTime            @map("effective_from") @db.Date
  effectiveTo     DateTime?           @map("effective_to") @db.Date
  /// GR / resolution number this version is based on. An unsourced rule is a bug.
  sourceReference String?             @map("source_reference") @db.VarChar(250)
  sourceUrl       String?             @map("source_url") @db.VarChar(500)
  status          SchemeVersionStatus @default(DRAFT)
  notes           String?             @db.VarChar(2000)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  scheme          Scheme                      @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  cases           Case[]
  ruleVersions    ValidationRuleVersion[]
  docRequirements SchemeDocumentRequirement[]

  @@unique([schemeId, versionLabel])
  @@index([schemeId, effectiveFrom])
  @@index([status])
  @@map("scheme_version")
}

model SchemeDocumentRequirement {
  id              String   @id @db.Uuid
  schemeVersionId String   @map("scheme_version_id") @db.Uuid
  documentTypeId  String   @map("document_type_id") @db.Uuid
  isMandatory     Boolean  @default(true) @map("is_mandatory")
  /// Optional condition expression, e.g. entity type restriction.
  appliesWhenExpr String?  @map("applies_when_expr") @db.VarChar(500)
  sortOrder       Int      @default(100) @map("sort_order")
  notes           String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")

  schemeVersion SchemeVersion @relation(fields: [schemeVersionId], references: [id], onDelete: Cascade)
  documentType  DocumentType  @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@unique([schemeVersionId, documentTypeId])
  @@map("scheme_document_requirement")
}

// ========================= CLIENT DOMAIN =========================

model Client {
  id               String     @id @db.Uuid
  firmId           String     @map("firm_id") @db.Uuid
  legalName        String     @map("legal_name") @db.VarChar(250)
  tradeName        String?    @map("trade_name") @db.VarChar(250)
  entityType       EntityType @map("entity_type")
  constitutionNote String?    @map("constitution_note") @db.VarChar(250)
  businessActivity String?    @map("business_activity") @db.VarChar(250)
  nicCode          String?    @map("nic_code") @db.VarChar(12)

  panEnc          Bytes?  @map("pan_enc")
  panLast4        String? @map("pan_last4") @db.VarChar(4)
  panBlindIndex   Bytes?  @map("pan_blind_index")
  gstinEnc        Bytes?  @map("gstin_enc")
  gstinLast4      String? @map("gstin_last4") @db.VarChar(4)
  gstinBlindIndex Bytes?  @map("gstin_blind_index")
  udyamEnc        Bytes?  @map("udyam_enc")
  udyamLast4      String? @map("udyam_last4") @db.VarChar(4)

  incorporationDate DateTime? @map("incorporation_date") @db.Date

  regdAddressLine1 String? @map("regd_address_line1") @db.VarChar(200)
  regdAddressLine2 String? @map("regd_address_line2") @db.VarChar(200)
  regdCity         String? @map("regd_city") @db.VarChar(100)
  regdDistrictCode String? @map("regd_district_code") @db.VarChar(12)
  regdPincode      String? @map("regd_pincode") @db.VarChar(6)

  contactPersonName String? @map("contact_person_name") @db.VarChar(160)
  contactEmail      String? @map("contact_email") @db.VarChar(254)
  contactPhone      String? @map("contact_phone") @db.VarChar(20)

  notes           String?   @db.VarChar(2000)
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  firm      Firm             @relation(fields: [firmId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  promoters ClientPromoter[]
  cases     Case[]
  consents  ConsentRecord[]

  @@unique([firmId, panBlindIndex])
  @@unique([firmId, gstinBlindIndex])
  @@index([firmId, deletedAt])
  @@index([firmId, legalName])
  @@index([firmId, createdAt])
  @@map("client")
}

model ClientPromoter {
  id               String       @id @db.Uuid
  firmId           String       @map("firm_id") @db.Uuid
  clientId         String       @map("client_id") @db.Uuid
  fullName         String       @map("full_name") @db.VarChar(160)
  designation      PromoterRole
  ownershipPercent Decimal?     @map("ownership_percent") @db.Decimal(5, 2)

  panEnc        Bytes?  @map("pan_enc")
  panLast4      String? @map("pan_last4") @db.VarChar(4)
  panBlindIndex Bytes?  @map("pan_blind_index")

  /// Last 4 digits only. Full Aadhaar storage is blocked by a CHECK constraint
  /// on aadhaar_ref_enc until a documented legal decision — see ADR-013.
  aadhaarLast4  String? @map("aadhaar_last4") @db.VarChar(4)
  aadhaarRefEnc Bytes?  @map("aadhaar_ref_enc")

  email        String?   @db.VarChar(254)
  phone        String?   @db.VarChar(20)
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  addressLine1 String?   @map("address_line1") @db.VarChar(200)
  city         String?   @db.VarChar(100)
  pincode      String?   @db.VarChar(6)
  isPrimary    Boolean   @default(false) @map("is_primary")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, panBlindIndex])
  @@index([firmId, clientId])
  @@index([clientId, isPrimary])
  @@map("client_promoter")
}

model Case {
  id                      String          @id @db.Uuid
  firmId                  String          @map("firm_id") @db.Uuid
  clientId                String          @map("client_id") @db.Uuid
  schemeVersionId         String          @map("scheme_version_id") @db.Uuid
  caseNumber              String          @map("case_number") @db.VarChar(32)
  title                   String?         @db.VarChar(200)
  applicationType         ApplicationType @map("application_type")
  status                  CaseStatus      @default(DRAFT)
  applicationDate         DateTime?       @map("application_date") @db.Date
  /// Typed in by the CA AFTER they submit on the portal themselves.
  portalApplicationNo     String?         @map("portal_application_no") @db.VarChar(64)
  filedAt                 DateTime?       @map("filed_at")
  filedByUserId           String?         @map("filed_by_user_id") @db.Uuid
  readinessScore          Int             @default(0) @map("readiness_score")
  lastValidationRunId     String?         @map("last_validation_run_id") @db.Uuid
  assignedToUserId        String?         @map("assigned_to_user_id") @db.Uuid
  duplicateOverrideReason String?         @map("duplicate_override_reason") @db.VarChar(500)
  statusReason            String?         @map("status_reason") @db.VarChar(500)
  deletedAt               DateTime?       @map("deleted_at")
  createdById             String?         @map("created_by_id") @db.Uuid
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  firm          Firm          @relation(fields: [firmId], references: [id], onDelete: Restrict)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  schemeVersion SchemeVersion @relation(fields: [schemeVersionId], references: [id], onDelete: Restrict)
  createdBy     User?         @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo    User?         @relation("CaseAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  project    Project?
  loan       Loan?
  employment Employment?
  investment Investment?
  firstSale  FirstSale?

  documents        CaseDocument[]
  validationRuns   CaseValidationRun[]
  autofillSessions AutofillSession[]
  consents         ConsentRecord[]

  @@unique([firmId, caseNumber])
  @@index([firmId, status])
  @@index([firmId, clientId])
  @@index([firmId, assignedToUserId, status])
  @@index([firmId, updatedAt])
  @@map("case")
}

