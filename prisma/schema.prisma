model ValidationRule {
  id        String        @id @db.Uuid
  code      String        @unique @db.VarChar(64)
  name      String        @db.VarChar(200)
  category  RuleCategory
  appliesTo RuleAppliesTo @default(CASE) @map("applies_to")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  versions ValidationRuleVersion[]

  @@index([category, isActive])
  @@map("validation_rule")
}

model ValidationRuleVersion {
  id              String       @id @db.Uuid
  ruleId          String       @map("rule_id") @db.Uuid
  /// Null = structural rule independent of scheme policy (e.g. PAN format).
  schemeVersionId String?      @map("scheme_version_id") @db.Uuid
  versionLabel    String       @map("version_label") @db.VarChar(32)
  severity        RuleSeverity @default(WARNING)
  /// Declarative AST evaluated by an allow-listed operator table. Never eval().
  expression      Json
  params          Json         @default("{}")
  messageTemplate String       @map("message_template") @db.VarChar(500)
  remediationHint String?      @map("remediation_hint") @db.VarChar(500)
  /// The GR / clause this rule comes from. An unsourced policy rule stays DRAFT.
  sourceReference String?      @map("source_reference") @db.VarChar(250)
  fieldCode       String?      @map("field_code") @db.VarChar(80)
  section         String?      @db.VarChar(32)
  effectiveFrom   DateTime?    @map("effective_from") @db.Date
  effectiveTo     DateTime?    @map("effective_to") @db.Date
  status          RuleStatus   @default(DRAFT)
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  rule          ValidationRule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  schemeVersion SchemeVersion?          @relation(fields: [schemeVersionId], references: [id], onDelete: Restrict)
  findings      CaseValidationFinding[]

  @@unique([ruleId, versionLabel])
  @@index([schemeVersionId, status])
  @@index([status, severity])
  @@map("validation_rule_version")
}

model CaseValidationRun {
  id                String            @id @db.Uuid
  firmId            String            @map("firm_id") @db.Uuid
  caseId            String            @map("case_id") @db.Uuid
  trigger           ValidationTrigger @default(MANUAL)
  startedAt         DateTime          @default(now()) @map("started_at")
  finishedAt        DateTime?         @map("finished_at")
  blockingCount     Int               @default(0) @map("blocking_count")
  warningCount      Int               @default(0) @map("warning_count")
  infoCount         Int               @default(0) @map("info_count")
  readinessScore    Int               @default(0) @map("readiness_score")
  /// Hash of the rule-version set that ran — lets us find cases validated
  /// under superseded rules after a scheme amendment.
  rulesetHash       String            @map("ruleset_hash") @db.VarChar(64)
  triggeredByUserId String?           @map("triggered_by_user_id") @db.Uuid

  firm        Firm                    @relation(fields: [firmId], references: [id], onDelete: Restrict)
  case        Case                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  triggeredBy User?                   @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  findings    CaseValidationFinding[]

  @@index([caseId, startedAt])
  @@index([firmId, startedAt])
  @@map("case_validation_run")
}

model CaseValidationFinding {
  id             String        @id @db.Uuid
  firmId         String        @map("firm_id") @db.Uuid
  runId          String        @map("run_id") @db.Uuid
  ruleVersionId  String        @map("rule_version_id") @db.Uuid
  severity       RuleSeverity
  /// Rendered message. References fields by LABEL — never interpolates a value.
  message        String        @db.VarChar(500)
  fieldCode      String?       @map("field_code") @db.VarChar(80)
  section        String?       @db.VarChar(32)
  status         FindingStatus @default(OPEN)
  waivedByUserId String?       @map("waived_by_user_id") @db.Uuid
  waivedAt       DateTime?     @map("waived_at")
  waiverReason   String?       @map("waiver_reason") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at")

  run         CaseValidationRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  ruleVersion ValidationRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  waivedBy    User?                 @relation(fields: [waivedByUserId], references: [id], onDelete: SetNull)

  @@index([runId, severity])
  @@index([firmId, severity, status])
  @@map("case_validation_finding")
}

