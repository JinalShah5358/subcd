// ===========================================================================
// EXTENSION: form catalog, field mappings and autofill telemetry
// 
// The IFP portal's HTML is not ours and will change without notice. Nothing
// here hard-codes a selector: a FormVersion is a CAPTURED snapshot of a real
// page, and every mapping hangs off that version. When the portal changes, a
// new version is captured and the old one keeps describing the cases that were
// prepared against it.
// 
// Capture is firm-scoped (firmId set) until someone curates it into the shared
// catalog (firmId null) — the same pattern Bank and DocumentType already use.
// ===========================================================================

enum FormVersionStatus {
  /// Captured from a real page, not yet reviewed.
  CAPTURED
  /// Reviewed and in use.
  ACTIVE
  /// Superseded by a newer capture.
  RETIRED
}

enum AutofillOutcome {
  FILLED
  /// The mapped control was not present on the page.
  MISSING
  /// Present but disabled, readonly or hidden — deliberately left alone.
  NOT_EDITABLE
  /// We had no value for it.
  NO_VALUE
  /// A select whose options did not contain our value.
  OPTION_NOT_FOUND
  /// Refused by policy: password, file, captcha, submit.
  REFUSED
  /// The CA chose not to fill it.
  SKIPPED
}

enum AutofillSessionStatus {
  STARTED
  COMPLETED
  ABANDONED
}

/// One form on the portal, identified by purpose rather than by URL.
model FormDefinition {
  id          String   @id @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  /// Host the extension is permitted to act on. Never a wildcard.
  host        String   @db.VarChar(120)
  /// Informational: the path where this form was found.
  pathHint    String?  @map("path_hint") @db.VarChar(250)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions FormVersion[]

  @@map("form_definition")
}

/// A captured snapshot of one form's structure at a point in time.
model FormVersion {
  id               String            @id @db.Uuid
  /// Null = curated into the shared catalog. Set = this firm's own capture.
  firmId           String?           @map("firm_id") @db.Uuid
  formId           String            @map("form_id") @db.Uuid
  label            String            @db.VarChar(80)
  status           FormVersionStatus @default(CAPTURED)
  /// Stable digest of the captured field set. Two captures with the same
  /// fingerprint describe the same form, which is how drift is detected.
  fingerprint      String            @db.VarChar(64)
  capturedAt       DateTime          @map("captured_at")
  capturedByUserId String?           @map("captured_by_user_id") @db.Uuid
  /// Free-text note from whoever captured or reviewed it.
  note             String?           @db.VarChar(500)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  firm     Firm?             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  form     FormDefinition    @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields   FormField[]
  mappings FieldMapping[]
  sessions AutofillSession[]

  @@index([firmId, formId, status])
  @@index([fingerprint])
  @@map("form_version")
}

/// One control discovered on the captured page.
model FormField {
  id            String   @id @db.Uuid
  firmId        String?  @map("firm_id") @db.Uuid
  formVersionId String   @map("form_version_id") @db.Uuid
  /// The selector the extension will use. Captured, never invented.
  selector      String   @db.VarChar(500)
  /// input | select | textarea | radio | checkbox
  controlType   String   @map("control_type") @db.VarChar(24)
  /// The type attribute for inputs (text, number, date, password, file…).
  inputType     String?  @map("input_type") @db.VarChar(24)
  labelText     String?  @map("label_text") @db.VarChar(250)
  nameAttr      String?  @map("name_attr") @db.VarChar(200)
  idAttr        String?  @map("id_attr") @db.VarChar(200)
  required      Boolean  @default(false)
  maxLength     Int?     @map("max_length")
  /// For selects: the options as captured, [{value,label}].
  options       Json?
  /// Set when the capture refused to record this control at all
  /// (password fields, file inputs, anything CAPTCHA-shaped).
  refusedReason String?  @map("refused_reason") @db.VarChar(120)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  firm        Firm?          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  formVersion FormVersion    @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  mappings    FieldMapping[]

  @@index([formVersionId, sortOrder])
  @@index([firmId])
  @@map("form_field")
}

/// Binds a captured control to one of our canonical data paths.
model FieldMapping {
  id            String   @id @db.Uuid
  firmId        String?  @map("firm_id") @db.Uuid
  formVersionId String   @map("form_version_id") @db.Uuid
  formFieldId   String   @map("form_field_id") @db.Uuid
  /// Canonical path into the case payload, e.g. "client.pan".
  sourcePath    String   @map("source_path") @db.VarChar(120)
  /// Optional named transform: upper, digitsOnly, dateDDMMYYYY, …
  transform     String?  @db.VarChar(40)
  /// For selects: our value -> the portal's option value.
  optionMap     Json?    @map("option_map")
  /// A mapping a human has confirmed against the real form.
  confirmed     Boolean  @default(false)
  note          String?  @db.VarChar(300)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  firm        Firm?       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  formField   FormField   @relation(fields: [formFieldId], references: [id], onDelete: Cascade)

  @@unique([formFieldId, sourcePath])
  @@index([formVersionId])
  @@index([firmId])
  @@map("field_mapping")
}

/// A browser that has been paired with this firm.
model ExtensionDevice {
  id            String    @id @db.Uuid
  firmId        String    @map("firm_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  label         String    @db.VarChar(120)
  /// SHA-256 of the device secret. The secret itself is never stored.
  secretHash    String    @unique @map("secret_hash") @db.VarChar(64)
  /// Extension version string, for support and drift triage.
  agentVersion  String?   @map("agent_version") @db.VarChar(32)
  lastSeenAt    DateTime? @map("last_seen_at")
  lastSeenIp    String?   @map("last_seen_ip") @db.Inet
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason") @db.VarChar(120)
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  firm     Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions AutofillSession[]

  @@index([firmId, userId])
  @@index([firmId, revokedAt])
  @@map("extension_device")
}

/// One autofill run against one case.
model AutofillSession {
  id              String                @id @db.Uuid
  firmId          String                @map("firm_id") @db.Uuid
  caseId          String                @map("case_id") @db.Uuid
  deviceId        String?               @map("device_id") @db.Uuid
  formVersionId   String?               @map("form_version_id") @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  status          AutofillSessionStatus @default(STARTED)
  /// Counts, so the common reporting query needs no aggregate over outcomes.
  fieldsAttempted Int                   @default(0) @map("fields_attempted")
  fieldsFilled    Int                   @default(0) @map("fields_filled")
  fieldsFailed    Int                   @default(0) @map("fields_failed")
  /// True when the captured page no longer matches the mapped version.
  driftDetected   Boolean               @default(false) @map("drift_detected")
  startedAt       DateTime              @default(now()) @map("started_at")
  finishedAt      DateTime?             @map("finished_at")

  firm        Firm                   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case        Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  device      ExtensionDevice?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  formVersion FormVersion?           @relation(fields: [formVersionId], references: [id], onDelete: SetNull)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcomes    AutofillFieldOutcome[]

  @@index([firmId, caseId, startedAt])
  @@index([firmId, startedAt])
  @@map("autofill_session")
}

/// What happened to one field in one run. Field NAMES only — never values.
model AutofillFieldOutcome {
  id         String          @id @db.Uuid
  firmId     String          @map("firm_id") @db.Uuid
  sessionId  String          @map("session_id") @db.Uuid
  /// Our canonical path, e.g. "client.pan". Not the value.
  sourcePath String          @map("source_path") @db.VarChar(120)
  /// The selector that was targeted, for drift triage.
  selector   String?         @db.VarChar(500)
  outcome    AutofillOutcome
  detail     String?         @db.VarChar(250)
  occurredAt DateTime        @default(now()) @map("occurred_at")

  firm    Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  session AutofillSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([firmId, sessionId])
  @@index([firmId, outcome])
  @@map("autofill_field_outcome")
}
