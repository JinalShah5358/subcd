{
  "name": "ifp-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant case management for Gujarat IFP subsidy applications (admin side: web + API)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.5.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@ifp/api",
    "dev:web": "npm run dev --workspace=@ifp/web",
    "build": "npm run build --workspace=@ifp/shared && npm run build --workspace=@ifp/api && npm run build --workspace=@ifp/web",
    "build:shared": "npm run build --workspace=@ifp/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres mailhog",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "setup": "npm install && npm run build:shared && npm run db:generate",
    "test:smoke": "node scripts/smoke.mjs",
    "test:extension": "vitest run --root apps/extension",
    "test:smoke:extension": "node scripts/smoke-extension.mjs",
    "test:all": "npm run test:shared --if-present && vitest run --root apps/api && vitest run --root apps/web && vitest run --root apps/extension",
    "test:smoke:all": "npm run test:smoke && npm run test:smoke:extension"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "concurrently": "8.2.2",
    "eslint": "8.57.0",
    "prisma": "5.22.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  }
}
